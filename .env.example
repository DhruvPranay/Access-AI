# Copy this file to .env and fill in what you have.

# Google Gemini API key — powers the AI features (plans, hints, code review,
# generated problems/quizzes, mock interviews). Get one free at
# https://aistudio.google.com/apikey  (it starts with "AIza").
# Without it the System runs on its built-in offline engine.
GEMINI_API_KEY=

# Optional: pin a model. By default the server picks the newest Gemini Flash
# model your key can access (e.g. gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash

# API server port (Vite proxies /api to this; keep in sync with vite.config.js)
API_PORT=8787

# Optional: Judge0 CE endpoint for running C / C++ / Java when no local
# compiler (gcc / g++ / javac) is installed.
# JUDGE0_URL=https://judge0-ce.p.rapidapi.com
# JUDGE0_KEY=
